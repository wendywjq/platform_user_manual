<p nodeId="5a55e83cb2e840b09735adfaaa371ae3">    public String  queryMtRealUserID(String dpUserId,String accountSystem,String zeusRequestId)  {</p>
<p nodeId="24b43f21fa9b44cbba22de109640dd96">        Map&lt;String,Object&gt; returnResult = Maps.newHashMap();</p>
<p nodeId="45b1659fb1ff48d9a28069bdfad23fb0">        try {</p>
<p nodeId="dfdbbe59e0d245ec9654e844ed4880f2">            FetchRequest request = new FetchRequest();</p>
<p nodeId="98efcbb0e60c42059c08ae688cd39945">            Map&lt;String,String&gt; queryContext = Maps.newHashMap();</p>
<p nodeId="39f240ed64ab41a1b8834e05d6bc7622">            request.setMethodName("userIdFetcher");</p>
<p nodeId="b62bc51c21d94651bf0b9d9361be25dd">            queryContext.put("dpUserid", dpUserId);</p>
<p nodeId="1800a908dbc447f4bb3117b56b4b16ed">            queryContext.put("accountSystem", accountSystem);</p>
<p nodeId="1e811c3b705440b084dec55e94faec5d">            request.setContext(queryContext).setRequestId(zeusRequestId);</p>
<p nodeId="ba8b26b40ae54cf0834627319444df51">            FetchResult result = service.query(request);</p>
<p nodeId="d028b0b5a0b445bd9db49cde297b0f0a">            if (StringUtils.isNotEmpty(result.getErrMsg())) {</p>
<p nodeId="1cb0a8986c3442b881155a5342480f9d">                LOGGER.error("queryMtRealUserID {}", result.getErrMsg());</p>
<p nodeId="7e50d67b57fb4ff0851fe7cec3312c2e">                return null;</p>
<p nodeId="49b4b966ac29420e9f75aebf5d70dd67">            }</p>
<p nodeId="afd18d50c905429caa3c086ea059cd18">            Map&lt;String,String&gt; resultMap = result.getResultMap();</p>
<p nodeId="e865e59d0e4547318cf8d6948d0302fb">            if (MapUtils.isEmpty(resultMap)) {</p>
<p nodeId="8fc38711733e4e2ab99811a246755572">                LOGGER.info("queryMtRealUserID empty context:{}", queryContext);</p>
<p nodeId="77f456e2bf994f409c56badebcec95be">                return null;</p>
<p nodeId="69972cf55478439692091eafc6dc2859">            }</p>
<p nodeId="be2f84973c4b4adbb15528f84dd6d99b">            return String.valueOf(resultMap.get("userid"));</p>
<p nodeId="b19b831359d5463d9df28e036e2880d2">        } catch (Exception e) {</p>
<p nodeId="61092847a88b4fe3801769b7e586ff82">            LOGGER.error("INVOKE_FETCHER_ERROR method:{} msg:{}", "dfpidOrUuidRiskFetcher", e.getMessage(), e);</p>
<p nodeId="0475c35987384c208a7b3c42777701ae">        }</p>
<p nodeId="9ddcbacf7e194e6e9bdd402681002379">        return null;</p>
<p nodeId="1c323b98ff2946a1892e15f955c9f308">    }</p>
<p nodeId="0d1ed233588d42a2a75687088b589bca">    @Override</p>
<p nodeId="4b97a334d32a4eb3b17714c1a2029ee1">    public Map&lt;String, Object&gt; process(Map&lt;String, Object&gt; map) {</p>
<p nodeId="1acd4a6cf1ee4871aea8fc9a31756ed3">        String dpUserId = String.valueOf(map.get("dpUserid"));</p>
<p nodeId="a15da310d8904a968250d650da34ab23">        String accountSystem = String.valueOf(map.get("accountSystem"));</p>
<p nodeId="368f5f98ece348ac9d7c7bd0f0b39a8a">        String zeusRequestId = (String)map.get("zeusRequestId");</p>
<p nodeId="5dd0db747eb24957bc382dfcced6608a">        LOGGER.error("UserIdTranslate :{},{},{}",dpUserId,accountSystem,zeusRequestId);</p>
<p nodeId="98d912fcd3bb4c6e8e1775e45a2aecaa">        if("8".equals(accountSystem) &amp;&amp; StringUtils.isNotEmpty(dpUserId)){</p>
<p nodeId="78188fd816064b358ca2cd22670b7a01">            Long current = System.currentTimeMillis();</p>
<p nodeId="7e9cf0dfcc314ad5b5330a892101294c">            Long eventTime = Long.valueOf(String.valueOf(map.get("eventTime")));</p>
<p nodeId="1d5bf5f4869d475386108aee14d62083">            if(eventTime != null &amp;&amp; current &lt; eventTime + 10000){</p>
<p nodeId="cabd1a457f734f07ac035be414d3ab7a">                try {</p>
<p nodeId="d7c7f0da07e1494c80556ce1741a2442">                    Thread.sleep(10000);</p>
<p nodeId="f425522707a04b5fb0c71ee141fbeb3e">                }catch (Exception ex){</p>
