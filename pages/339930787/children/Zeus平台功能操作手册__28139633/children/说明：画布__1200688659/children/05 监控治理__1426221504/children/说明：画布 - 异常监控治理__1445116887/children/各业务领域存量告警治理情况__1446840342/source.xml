<p nodeId="df969756d7da4ef5b26c57c8ce3f1373">            }</p>
<p nodeId="f82445a6507048119dc666f13a012e02">            String realUserId = queryMtRealUserID(dpUserId,accountSystem,zeusRequestId);</p>
<p nodeId="cfc4cfd511914e8ba583a64dde04cb37">            if(StringUtils.isNotEmpty(realUserId)){</p>
<p nodeId="bf63f4f6c0134340b0a12c8dcf68ab5d">                map.put("oriUserid",map.get("userid"));</p>
<p nodeId="923b954ced0640b4a888a1afd8e9bbd8">                map.put("userid",realUserId);</p>
<p nodeId="a5daef1f055249c0a9150a4b27246da4">            }</p>
<p nodeId="610df886831b44abaaf8cc4a74cb6105">        }</p>
<p nodeId="b65fa3c51d6d46a5b47e4cc669dcfc17">        return map;</p>
<p nodeId="877e0de7c06b49ab8a0275eb6478afe2">    }</p>
<p nodeId="06ebe579486243369a3bcafaf0b9ad22">}</p>
