<h4 nodeId="927a2587b288455d893ce3e69536c7f8">利用数据源注册特征</h4>
<table borderColor="#cccccc" responsive="false" nodeId="d777a2cd8fb740959e2be24718e068b3">
<tr nodeId="23efb19cfc724cc6b304d0fc9cc74c71">
<th colwidth="[434]" verticalAlign="top" bgColor="rgb(246, 246, 246)" nodeId="6ec050c33dc048a09690dc222f39c835">
