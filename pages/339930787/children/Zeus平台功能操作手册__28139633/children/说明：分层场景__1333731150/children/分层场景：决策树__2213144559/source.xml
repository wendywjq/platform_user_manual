<h2 nodeId="e7bb3048ff33424f81f5333b28eabea2">2.1 决策总览组件</h2>
<table responsive="false" nodeId="1b4e00fc17984cbd89d77f3bb6a2f701">
<tr nodeId="52c35bfe5c0241b897f2411c30eaae24">
<th colwidth="[93]" verticalAlign="top" bgColor="rgb(0, 58, 140)" nodeId="5cb83f6544694d3687cf6a5c4dd94819">
<p nodeId="87df0412eaac4e13a7922c0a82eeb467"><span color="rgb(255, 255, 255)"><span font-size="14">功能模块</span></span></p>
</th>
<th colwidth="[645]" verticalAlign="top" bgColor="rgb(0, 58, 140)" nodeId="bf16aa2dde414b538fc87c6d46de9eef">
<p nodeId="6d075142b8964f5e8f726a699a5aa376"><strong><span color="rgb(255, 255, 255)"><span font-size="14">说明</span></span></strong></p>
</th>
<th colwidth="[671]" verticalAlign="top" bgColor="rgb(0, 58, 140)" nodeId="f60b1196bee34754ac70dfbdd4d0a417">
<p nodeId="2304a6303fe147febec35cc86d774cbe"><span color="rgb(255, 255, 255)"><span font-size="14">图</span></span></p>
</th>
